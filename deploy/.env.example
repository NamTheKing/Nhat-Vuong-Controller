# Copy to deploy/.env (git-ignored) and fill in. Never commit real values.
POSTGRES_PASSWORD=
# At least 32 random bytes, e.g.:  openssl rand -base64 48
JWT_SIGNING_KEY=
MQTT_SERVER_PASSWORD=
# Password of deploy/certs/mqtt.pfx (see deploy/scripts/new-mqtt-cert.ps1)
MQTT_CERT_PASSWORD=
ADMIN_EMAIL=admin@nhatvuong.edu.vn
ADMIN_PASSWORD=
# Optional e-mail delivery of maintenance notifications
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
