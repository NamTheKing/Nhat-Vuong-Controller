<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:NhatVuong.Client.Localization"
             xmlns:vm="clr-namespace:NhatVuong.Client.ViewModels"
             xmlns:api="clr-namespace:NhatVuong.Contracts.Api;assembly=NhatVuong.Contracts"
             x:Class="NhatVuong.Client.Views.MyClassesPage"
             x:DataType="vm:MyClassesViewModel"
             Title="{loc:Tr Classes_Title}">
    <Grid RowDefinitions="Auto,*,Auto" Padding="16,8">
        <VerticalStackLayout>
            <Label Text="{Binding Message}" Style="{StaticResource ErrorLabel}" IsVisible="{Binding Message, Converter={StaticResource NotNull}}" />
            <Label Text="{loc:Tr Classes_Empty}" Style="{StaticResource MutedLabel}" IsVisible="{Binding IsEmpty}" />
        </VerticalStackLayout>
        <RefreshView Grid.Row="1" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}">
            <CollectionView ItemsSource="{Binding Classes}" SelectionMode="Single" SelectedItem="{Binding Selected}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="api:ClassDto">
                        <Border Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="2">
                                <Label FontAttributes="Bold" FontSize="16">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding RoomCode}" />
                                            <Span Text="  ·  " />
                                            <Span Text="{Binding StartsAt, Converter={StaticResource LocalTime}, ConverterParameter='ddd dd/MM HH:mm'}" />
                                            <Span Text=" – " />
                                            <Span Text="{Binding EndsAt, Converter={StaticResource LocalTime}, ConverterParameter='HH:mm'}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label Text="{Binding ExternalId}" Style="{StaticResource MutedLabel}" />
                                <Label Text="{Binding PreCoolStatus, Converter={StaticResource EnumText}}" TextColor="{StaticResource Brand}"
                                       IsVisible="{Binding PreCoolStatus, Converter={StaticResource NotNull}}" />
                                <Label Style="{StaticResource MutedLabel}" IsVisible="{Binding PreCoolDueAt, Converter={StaticResource NotNull}}"
                                       Text="{Binding PreCoolDueAt, Converter={StaticResource ResourceFormat}, ConverterParameter=Classes_PreCoolAt}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="10" Padding="0,8">
            <Button Text="{loc:Tr Classes_PreCool}" Style="{StaticResource Primary}" Command="{Binding SchedulePreCoolCommand}" />
            <Button Grid.Column="1" Text="{loc:Tr Classes_CancelPreCool}" Command="{Binding CancelPreCoolCommand}" />
        </Grid>
    </Grid>
</ContentPage>
