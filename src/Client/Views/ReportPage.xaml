<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:NhatVuong.Client.Localization"
             xmlns:vm="clr-namespace:NhatVuong.Client.ViewModels"
             x:Class="NhatVuong.Client.Views.ReportPage"
             x:DataType="vm:ReportViewModel"
             Title="{loc:Tr Report_Title}">
    <Grid RowDefinitions="Auto,*" Padding="16" MaximumWidthRequest="720">
        <VerticalStackLayout Spacing="8">
            <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                <Picker Title="{loc:Tr Report_Year}" ItemsSource="{Binding Years}" SelectedItem="{Binding Year}" />
                <Picker Grid.Column="1" Title="{loc:Tr Report_Month}" ItemsSource="{Binding Months}" SelectedItem="{Binding Month}" />
                <Button Grid.Column="2" Text="{loc:Tr Report_Load}" Style="{StaticResource Primary}" Command="{Binding LoadCommand}" />
            </Grid>
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Text="{Binding Summary}" FontAttributes="Bold" FontSize="16" />
            <Label Text="{Binding Message}" Style="{StaticResource ErrorLabel}" IsVisible="{Binding Message, Converter={StaticResource NotNull}}" />
        </VerticalStackLayout>
        <CollectionView Grid.Row="1" ItemsSource="{Binding Rows}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ReportRow">
                    <Grid ColumnDefinitions="*,Auto" Padding="0,5">
                        <Label Text="{Binding Label}" />
                        <Label Grid.Column="1" Text="{Binding Hours}" />
                        <Grid.Triggers>
                            <DataTrigger TargetType="Grid" Binding="{Binding IsBuilding}" Value="True">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#E8F0FE, Dark=#1F2A37}" />
                            </DataTrigger>
                        </Grid.Triggers>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
