<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:NhatVuong.Client.Localization"
             xmlns:vm="clr-namespace:NhatVuong.Client.ViewModels"
             xmlns:api="clr-namespace:NhatVuong.Contracts.Api;assembly=NhatVuong.Contracts"
             x:Class="NhatVuong.Client.Views.RegisterDevicePage"
             x:DataType="vm:RegisterDeviceViewModel"
             Title="{loc:Tr Register_Title}">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="8" MaximumWidthRequest="720">
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="{loc:Tr Register_Qr}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Entry Text="{Binding QrCode}" Placeholder="NVC:AC-00123" />
                        <Button Grid.Column="1" Text="{loc:Tr Register_Scan}" Command="{Binding ScanCommand}" />
                    </Grid>
                    <Picker Title="{loc:Tr Common_Room}" ItemsSource="{Binding Rooms}" SelectedItem="{Binding SelectedRoom}" ItemDisplayBinding="{Binding Code, x:DataType=api:RoomDto}" />
                    <Entry Placeholder="{loc:Tr Register_Name}" Text="{Binding Name}" />
                    <Button Text="{loc:Tr Register_Button}" Style="{StaticResource Primary}" Command="{Binding RegisterCommand}" />
                    <Label Text="{Binding CredentialsText}" FontFamily="monospace" IsVisible="{Binding CredentialsText, Converter={StaticResource NotNull}}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="{loc:Tr Register_Devices}" Style="{StaticResource Section}" />
            <CollectionView ItemsSource="{Binding Devices}" SelectionMode="Single" SelectedItem="{Binding SelectedDevice}" HeightRequest="260">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="api:DeviceDto">
                        <Label Padding="4,6">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding HardwareId}" FontAttributes="Bold" />
                                    <Span Text=" — " />
                                    <Span Text="{Binding Name}" />
                                    <Span Text=" · " />
                                    <Span Text="{Binding RoomCode}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Button Text="{loc:Tr Common_Delete}" Command="{Binding DeleteDeviceCommand}" HorizontalOptions="Start" />
            <Label Text="{Binding Message}" Style="{StaticResource ErrorLabel}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
