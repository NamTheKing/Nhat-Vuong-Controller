<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:NhatVuong.Client.Localization"
             xmlns:vm="clr-namespace:NhatVuong.Client.ViewModels"
             xmlns:api="clr-namespace:NhatVuong.Contracts.Api;assembly=NhatVuong.Contracts"
             x:Class="NhatVuong.Client.Views.NotificationsPage"
             x:DataType="vm:NotificationsViewModel"
             Title="{loc:Tr Notifications_Title}">
    <Grid RowDefinitions="Auto,*" Padding="16,8">
        <VerticalStackLayout>
            <Button Text="{loc:Tr Notifications_MarkAll}" Command="{Binding MarkAllReadCommand}" HorizontalOptions="End" />
            <Label Text="{loc:Tr Notifications_Empty}" Style="{StaticResource MutedLabel}" IsVisible="{Binding IsEmpty}" />
            <Label Text="{Binding Message}" Style="{StaticResource ErrorLabel}" IsVisible="{Binding Message, Converter={StaticResource NotNull}}" />
        </VerticalStackLayout>
        <RefreshView Grid.Row="1" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}">
            <CollectionView ItemsSource="{Binding Notifications}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="api:NotificationDto">
                        <Border Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="2">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                    <Ellipse WidthRequest="8" HeightRequest="8" Fill="{StaticResource Brand}" VerticalOptions="Center"
                                             IsVisible="{Binding IsRead, Converter={StaticResource InverseBool}}" />
                                    <Label Grid.Column="1" Text="{Binding Title}" FontAttributes="Bold" />
                                </Grid>
                                <Label Text="{Binding Body}" />
                                <Label Style="{StaticResource MutedLabel}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding Category}" />
                                            <Span Text=" · " />
                                            <Span Text="{Binding CreatedAt, Converter={StaticResource LocalTime}}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
