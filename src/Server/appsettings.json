{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Localization": {
    "ServerCulture": "vi"
  },
  "Database": {
    "Provider": "Postgres",
    "ConnectionString": "Host=localhost;Database=nhatvuong;Username=nhatvuong"
  },
  "Mqtt": {
    "EmbeddedBroker": true,
    "Host": "localhost",
    "AllowPlaintext": false,
    "TlsPort": 8883,
    "UseTls": true,
    "ServerUsername": "nvc-server",
    "IngestWorkers": 4
  },
  "Scheduler": {
    "Enabled": true,
    "TickSeconds": 15,
    "ConfigRefreshMinutes": 10
  },
  "Auth": {
    "Issuer": "nhatvuong-controller",
    "Audience": "nhatvuong-clients",
    "TokenLifetimeHours": 8
  },
  "Signing": {
    "KeyPath": "keys/grant-signing.pem"
  },
  "Seed": {
    "DemoData": false
  },
  "Notifications": {
    "SmtpHost": ""
  }
}
